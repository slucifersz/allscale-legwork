{
  "name": "@agent-payroll/cctp-sweep",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Sweep the agent's Solana USDC into the operator's EVM wallet via Circle CCTP V2 (burn on Solana \u2192 attestation \u2192 mint on EVM).",
  "scripts": {
    "sweep": "node --import tsx src/sweep.ts",
