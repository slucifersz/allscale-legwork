# AllScale Store API credentials (HMAC). NOT the CLI agent credential — different product.
# The key must carry the explicit scope claim_link:auto_payout. Get it from Dashboard → Checkout → Store Settings → Payout → "API access"
# card (appears only after the payout authorization wizard). Commerce store keys and CLI agent keys (ask_…) will NOT work.
# Store HMAC (thirdparty) API host — NOT the Dashboard host.
#   production: https://openapi.allscale.io
#   gamma:      https://openapi-sandbox.allscale.io   (verified 2026-10-10; the CLI help text says "openapi-beta" but that is a
#               separate environment with its own DB and rejects gamma keys with 20002 invalid_key; gamma.allscale.io/api is the
#               Main API process and answers 2012 "Auth error!" to everything)
ALLSCALE_BASE_URL=https://openapi-sandbox.allscale.io
ALLSCALE_API_KEY=
ALLSCALE_API_SECRET=

# Payout defaults. chain: 1 Ethereum, 5 Base, 6 BNB, 7 Arbitrum, 8 Polygon, 9 Optimism, 11 Sepolia (test env only)
# stable_coin: 1 USDT, 2 USDC
ALLSCALE_CHAIN=11
# gamma operator wallet holds USDT on Sepolia; USDC only if you funded it
ALLSCALE_STABLE_COIN=1
ALLSCALE_SENDER_DISPLAY_NAME=Agent Payroll

# Webhook signing secret (from Dashboard) — only needed if you run the webhook receiver
ALLSCALE_WEBHOOK_SECRET=

# Where the orchestrator persists obligations / payouts / claims (JSON file)
PAYROLL_DATA_DIR=../../data
