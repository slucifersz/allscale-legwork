# ---- Solana ----
SOLANA_RPC_URL=https://api.devnet.solana.com
# CAIP-2 network id: devnet solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1 | mainnet solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# Devnet USDC mint (Circle)
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# The agent's receiving wallet (owner pubkey). Create its USDC ATA before advertising the route.
SOLANA_PAY_TO=

# ---- x402 ----
# facilitator | selfverify
#   facilitator: standard x402 flow via @x402/express + FACILITATOR_URL (must list "exact" for X402_NETWORK at /supported)
#   selfverify : fallback — client sends the Solana tx signature in header X-Solana-Tx; we check the USDC transfer on-chain ourselves
X402_MODE=facilitator
# x402.org default facilitator is documented as supporting Solana devnet (testnet only); confirm with GET <url>/supported
FACILITATOR_URL=https://x402.org/facilitator
# price per job in USD-denominated string the middleware understands, e.g. "$9"; selfverify mode uses JOB_PRICE_USDC
# (JOB_PRICE in "$" form is not used; price is pinned to USDC_MINT via JOB_PRICE_USDC)
JOB_PRICE_USDC=9

PORT=4020
# shared with orchestrator package
PAYROLL_DATA_DIR=../payout-orchestrator/data
