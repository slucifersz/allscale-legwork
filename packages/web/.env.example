PORT=4030
# shared ledger with the orchestrator + x402 server
PAYROLL_DATA_DIR=../../data
# operator pages (/review) are protected by this token: /review?token=...
OPERATOR_TOKEN=change-me
# explorer links for the settlement record
SOLANA_EXPLORER=https://explorer.solana.com/tx/{sig}?cluster=devnet
EVM_EXPLORER=https://sepolia.etherscan.io/tx/{hash}
# AllScale creds are read from the orchestrator package's env (ALLSCALE_*) — put them in this .env too
